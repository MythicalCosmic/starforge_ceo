{
  "name": "starforge-console",
  "version": "1.0.0",
  "private": true,
  "description": "StarForge EDU — CEO and manager leadership workspace",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23 || >=24 <25",
    "npm": ">=10.9.8 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "VITE_BUNDLE_REPORT=true vite build",
    "preview": "vite preview",
    "tunnel": "npm run build && vite preview --port 5173 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:schema": "node scripts/validate-schema.mjs",
    "check": "npm run lint && npm test && npm run build",
    "audit:all": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^6.4.3",
    "vitest": "4.1.10"
  }
}
