# StarForge CEO/Manager console API configuration.
# Copy this file to `.env.local` for Vite development or `.env` for Compose.
# Never commit `.env*` files containing deployment-specific values.

# The production container proxies `/api/*` to API_UPSTREAM through Nginx, so
# the browser should normally use a same-origin relative URL.
VITE_API_URL=

# Development only: Vite proxies `/api/*` to this HTTPS tenant host when the
# browser-facing base URL above is empty.
VITE_API_PROXY_TARGET=https://your-tenant.example.com

# Optional local-only listener override. The safe default is 127.0.0.1; set an
# explicit trusted interface only when testing from another device.
VITE_DEV_HOST=127.0.0.1

# Live API mode is the safe default. Fixed dashboard fixtures must be an
# explicit development-only opt-in and must never enter a production build.
VITE_USE_MOCK=false

# Fixed-fixture development role only. Live role and scope come exclusively
# from `/api/v1/users/me/`; only director and head_of_dept are admitted.
VITE_ROLE=ceo

# Docker Compose runtime controls. Production should set CONSOLE_IMAGE to an
# immutable registry digest after CI publishes the verified image.
API_UPSTREAM=https://your-tenant.example.com
CONSOLE_IMAGE=starforge-console:1.0.0
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8080
